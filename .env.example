# Caminho para o modelo de voz do Piper. No Docker, será models/pt_BR-faber-medium.onnx
MODEL_PATH=models/pt_BR-faber-medium.onnx

# Token de autenticação da API (Deixe em branco para API pública, sem proteção)
# Envie o token no Header da requisição: "Authorization: Bearer SEU_TOKEN"
API_TOKEN=sk_piper_x987y654z321w123

# Ativar interface web simples para testes (true ou false)
# Se true, acesse a raiz / no navegador para usar a UI.
ENABLE_WEB_INTERFACE=true
